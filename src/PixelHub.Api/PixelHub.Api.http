# Carnet de tests PixelHub — cliquer sur « Send request » au-dessus de chaque bloc.
# Port : celui affiché par `dotnet run` (5199 via launchSettings.json),
# et aussi celui de l'API conteneurisée (docker compose --profile app up -d).
@host = http://localhost:5199

### Santé
GET {{host}}/

### Séance 1 — PostgreSQL
GET {{host}}/players
Accept: application/json

### Séance 1 — bonus : créer un joueur
POST {{host}}/players
Content-Type: application/json

### Séance 2 — MongoDB : catalogue complet
GET {{host}}/games
Accept: application/json

### Séance 2 — filtrage par genre
GET {{host}}/games/genre/FPS
Accept: application/json

### Séance 2 — top 3
GET {{host}}/games/top/3
Accept: application/json

### Séance 2 — agrégation : note moyenne par genre
GET {{host}}/games/stats
Accept: application/json

### Séance 3 — Redis : ajouter des points à Nova
POST {{host}}/leaderboard/Nova/points/4500

### Séance 3 — Redis : ajouter des points à Krayz
POST {{host}}/leaderboard/Krayz/points/3200

### Séance 3 — Redis : ajouter des points à Ombre
POST {{host}}/leaderboard/Ombre/points/5100

### Séance 3 — Redis : ajouter des points à Pixel
POST {{host}}/leaderboard/Pixel/points/1800

### Séance 3 — Redis : top 5
GET {{host}}/leaderboard/top/5
Accept: application/json

### Séance 3 — Redis : rang de Krayz
GET {{host}}/leaderboard/rank/Krayz
Accept: application/json

### Séance 3 — Redis : mesure du cache
GET {{host}}/games/timed
Accept: application/json

{ "pseudo": "Pixel", "coins": 500 }
